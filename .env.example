# Model service for every DeepSeek-style role (OpenAI-compatible chat API).
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=60

# Optional per-role overrides; each field falls back to LLM_* when unset.
# USER_SIM_MODEL=...      # simulated user in free dialogue
# JUDGE_MODEL=...         # answer extraction, rubric judge, simulator audit
# OPENING_MODEL=...       # opening and agent-policy writers
# DOMAIN_MODEL=...        # domain proposals from the knowledge graph

# Optional: sample generation domains from a Neo4j business knowledge graph (pip extra "graph").
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=replace-with-your-neo4j-password
# NEO4J_DATABASE=neo4j

# Optional: require a bearer token on `python -m env_factory serve`.
# SANDBOX_SERVICE_TOKEN=replace-with-a-random-token
# Optional: disable the audit of failed free-dialogue episodes for simulator slips.
# SIMULATOR_AUDIT=off
