NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=replace-with-your-model
LLM_TIMEOUT=60
# 正式 live/production 实验：分别配置 Rollout Agent 与 User/Judge 端点。
# 以下各项不配置时按字段回退到上方 LLM_*，正式认证须使用独立身份。
# ROLLOUT_LLM_API_KEY=replace-with-rollout-agent-key
# ROLLOUT_LLM_BASE_URL=https://your-rollout-provider.example/v1
# ROLLOUT_LLM_MODEL=replace-with-rollout-agent-model
# ROLLOUT_LLM_ALLOWED_RESPONSE_MODELS=replace-with-rollout-agent-model
# SANDBOX_LLM_API_KEY=replace-with-user-judge-key
# SANDBOX_LLM_BASE_URL=https://your-user-judge-provider.example/v1
# SANDBOX_LLM_MODEL=replace-with-user-judge-model
# SANDBOX_LLM_ALLOWED_RESPONSE_MODELS=replace-with-user-judge-model
# 正式素材包签名密钥文件路径；私钥文件不得放入仓库或 Docker 构建上下文。
# ENVFACTORY_BUNDLE_SIGNING_PRIVATE_KEY=/absolute/path/to/signing-private.pem
# ENVFACTORY_BUNDLE_TRUSTED_PUBLIC_KEY=/absolute/path/to/trusted-public.pem
WIKIPEDIA_API_URL=https://zh.wikipedia.org/w/api.php
WIKIPEDIA_TIMEOUT=10
# 配置后使用本地 dump 索引；不配置则使用在线 Action API
# WIKIPEDIA_DUMP_DB=data/wikipedia.sqlite3
NEO4J_DATABASE=neo4j
GRAPH_SEEDS_FILE=data/scene_seeds.txt
LOG_LEVEL=INFO
