NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-with-your-neo4j-password
LLM_API_KEY=replace-with-your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL are optional local aliases; clients read the role-specific fields above/below.
# Kimi K3 only: low, high, or max (default max).
# KIMI_K3_REASONING_EFFORT=low
LLM_TIMEOUT=60
# 沙箱 User/Judge 配置；RL 策略使用训练命令 --model 指定的本地模型。
# API 后端按字段回退到 LLM_*；Codex 后端必须显式配置桥接参数。
# SANDBOX_LLM_API_KEY=replace-with-user-judge-key
# SANDBOX_LLM_BASE_URL=https://your-user-judge-provider.example/v1
# SANDBOX_LLM_MODEL=replace-with-user-judge-model
# SANDBOX_LLM_ALLOWED_RESPONSE_MODELS=replace-with-user-judge-model
# 本机 Codex 评分桥接：先启动 python -m env_factory.code_agent_runtime，见 docs/code_agent_authoring.md。
# SANDBOX_LLM_BACKEND=codex
# SANDBOX_LLM_API_KEY=copy-local-bridge-token-not-codex-credentials
# SANDBOX_LLM_BASE_URL=http://127.0.0.1:55794/v1
# SANDBOX_LLM_CONTAINER_BASE_URL=http://host.docker.internal:55794/v1
# SANDBOX_LLM_MODEL=gpt-6.1-sol
# SANDBOX_LLM_ALLOWED_RESPONSE_MODELS=gpt-6.1-sol
# SANDBOX_LLM_TIMEOUT_SECONDS=190
# 正式素材包签名密钥文件路径；私钥文件不得放入仓库或 Docker 构建上下文。
# ENVFACTORY_BUNDLE_SIGNING_PRIVATE_KEY=/absolute/path/to/signing-private.pem
# ENVFACTORY_BUNDLE_TRUSTED_PUBLIC_KEY=/absolute/path/to/trusted-public.pem
WIKIPEDIA_API_URL=https://zh.wikipedia.org/w/api.php
WIKIPEDIA_TIMEOUT=10
# 配置后使用本地 dump 索引；不配置则使用在线 Action API
# WIKIPEDIA_DUMP_DB=data/wikipedia.sqlite3
NEO4J_DATABASE=neo4j
GRAPH_SEEDS_FILE=data/scene_seeds.txt
LOG_LEVEL=INFO
# Codex 默认 auto 保留客户端传输；连接反复超时时可用 https（仅默认 OpenAI provider/地址）。
# 生成、构建、独立审查统一使用；不修改全局 Codex 配置或降低验收要求。
# ENVFACTORY_CODEX_TRANSPORT=https
